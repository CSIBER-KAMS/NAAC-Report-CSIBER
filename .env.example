# CSIBER AQAR — environment configuration.
# Copy to .env (Docker) or /etc/aqar/aqar.env (systemd) and fill in.
# This file is committed; .env is NOT — never commit real values.

# ---------------------------------------------------------------------------
# REQUIRED. Signs session cookies. The application refuses to start without it.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs everyone out, which is harmless (12-hour sessions).
# ---------------------------------------------------------------------------
AQAR_SECRET=

# Public origin, used to reject cross-site form posts.
APP_ORIGIN=https://aqar.siberindia.edu.in

# Set to 1 ONLY when a reverse proxy you control (nginx) sets
# X-Forwarded-For. It makes per-IP login throttling work. Leave unset when
# the app is exposed directly, or the header can be spoofed to defeat it.
TRUSTED_PROXY=1

# Where the database, uploads and generated documents live.
# Docker: /data (the mounted volume). systemd: /opt/aqar/data.
AQAR_DATA_DIR=/data

NODE_ENV=production
PORT=3000

# ---------------------------------------------------------------------------
# Optional: initial account passwords for `npm run seed`.
# Set these so real credentials never appear in the repository or in a log.
# ---------------------------------------------------------------------------
# SEED_ADMIN_PASSWORD=
# SEED_HEAD_PASSWORD=
